<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Inventário (Fig. 18 revisada): lista de inventários; abas Contagem (cega, com o leitor) e Divergências (R13);
     Aplicar e Cancelar. Ctrl+N cria um inventário. -->
<VBox fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.InventarioController"
      spacing="10" styleClass="tela-cadastro">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Inventário" styleClass="titulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <CheckBox fx:id="filtroEncerrados" text="Mostrar aplicados e cancelados" onAction="#pesquisar"/>
        <Button text="Novo inventário… (Ctrl+N)" onAction="#novo" styleClass="botao-primario"/>
    </HBox>

    <SplitPane orientation="VERTICAL" dividerPositions="0.27" VBox.vgrow="ALWAYS">
        <TableView fx:id="tabelaInventarios">
            <placeholder><Label text="Nenhum inventário. Crie um em &quot;Novo inventário…&quot;."/></placeholder>
            <columns>
                <TableColumn fx:id="colunaNumero" text="Nº" prefWidth="60" styleClass="coluna-numero"/>
                <TableColumn fx:id="colunaDescricao" text="Descrição" prefWidth="260"/>
                <TableColumn fx:id="colunaSituacao" text="Situação" prefWidth="90"/>
                <TableColumn fx:id="colunaCriadoEm" text="Criado em" prefWidth="130"/>
                <TableColumn fx:id="colunaCriadoPor" text="Criado por" prefWidth="140"/>
                <TableColumn fx:id="colunaItens" text="Itens" prefWidth="70" styleClass="coluna-numero"/>
                <TableColumn fx:id="colunaContados" text="Contados" prefWidth="80" styleClass="coluna-numero"/>
                <TableColumn fx:id="colunaAplicado" text="Aplicado em / por" prefWidth="220"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        </TableView>

        <VBox spacing="8">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="tituloInventario" text="Selecione um inventário" styleClass="titulo-secao"/>
                <Label fx:id="situacao" styleClass="subtitulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="botaoAplicar" text="Aplicar…" onAction="#aplicar" styleClass="botao-primario"/>
                <Button fx:id="botaoCancelar" text="Cancelar inventário…" onAction="#cancelar"/>
            </HBox>
            <Label fx:id="orientacao" styleClass="subtitulo" wrapText="true"
                   text="Conte com a loja fechada ou digite a contagem logo depois de contar cada item: o que for vendido entre a contagem e a aplicação continua descontado."/>

            <TabPane fx:id="abas" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <Tab fx:id="abaContagem" text="Contagem">
                    <VBox spacing="8">
                        <padding><Insets top="8" right="0" bottom="0" left="0"/></padding>
                        <HBox fx:id="painelInclusao" alignment="CENTER_LEFT" spacing="8">
                            <Label text="Incluir produtos:" minWidth="110"/>
                            <TextField fx:id="campoInclusao" promptText="Código de barras, código ou nome (Enter)"
                                       HBox.hgrow="ALWAYS" onAction="#incluir"/>
                            <Button text="Incluir" onAction="#incluir"/>
                            <Button text="Por categoria…" onAction="#incluirCategoria"/>
                            <Button text="Todos os ativos…" onAction="#incluirTodos"/>
                            <Button fx:id="botaoRemover" text="Remover item…" onAction="#removerItem"/>
                        </HBox>
                        <HBox fx:id="painelContagem" alignment="CENTER_LEFT" spacing="8" styleClass="painel-formulario">
                            <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                            <Label text="Contar:" minWidth="102"/>
                            <TextField fx:id="campoLeitura" promptText="Leia o código de barras (ou código / nome)"
                                       prefWidth="280" onAction="#localizar"/>
                            <Label fx:id="produtoAtual" text="Nenhum item escolhido" styleClass="produto-contagem"
                                   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label text="Contado *"/>
                            <TextField fx:id="campoQuantidade" promptText="0" prefWidth="110" styleClass="campo-numero"
                                       onAction="#gravarContagem"/>
                            <Button fx:id="botaoGravar" text="Gravar" onAction="#gravarContagem"/>
                        </HBox>
                        <TableView fx:id="tabelaContagem" VBox.vgrow="ALWAYS">
                            <placeholder><Label fx:id="semItens" text="Nenhum produto neste inventário."/></placeholder>
                            <columns>
                                <TableColumn fx:id="colunaContagemCodigo" text="Código" prefWidth="70" styleClass="coluna-numero"/>
                                <TableColumn fx:id="colunaContagemBarras" text="Código de barras" prefWidth="130"/>
                                <TableColumn fx:id="colunaContagemProduto" text="Produto" prefWidth="300"/>
                                <TableColumn fx:id="colunaContagemUnidade" text="Unidade" prefWidth="70"/>
                                <TableColumn fx:id="colunaContagemContado" text="Contado" prefWidth="100" styleClass="coluna-numero"/>
                                <TableColumn fx:id="colunaContagemPor" text="Contado por" prefWidth="140"/>
                                <TableColumn fx:id="colunaContagemEm" text="Contado em" prefWidth="130"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                        </TableView>
                        <Label fx:id="resumoContagem" styleClass="subtitulo"/>
                    </VBox>
                </Tab>

                <Tab fx:id="abaDivergencias" text="Divergências">
                    <VBox spacing="8">
                        <padding><Insets top="8" right="0" bottom="0" left="0"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <padding><Insets right="8"/></padding>
                            <Label text="Resultado do inventário (R13)" styleClass="titulo-secao"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <CheckBox fx:id="filtroSoDiferencas" text="Só itens com diferença"
                                      onAction="#carregarDivergencias"/>
                        </HBox>
                        <TableView fx:id="tabelaDivergencias" VBox.vgrow="ALWAYS">
                            <placeholder><Label text="Nenhum item para mostrar."/></placeholder>
                            <columns>
                                <TableColumn fx:id="colunaDivCodigo" text="Código" prefWidth="70" styleClass="coluna-numero"/>
                                <TableColumn fx:id="colunaDivProduto" text="Produto" prefWidth="280"/>
                                <TableColumn fx:id="colunaDivUnidade" text="Unidade" prefWidth="70"/>
                                <TableColumn fx:id="colunaDivSistema" text="Sistema" prefWidth="100" styleClass="coluna-numero"/>
                                <TableColumn fx:id="colunaDivContado" text="Contado" prefWidth="100" styleClass="coluna-numero"/>
                                <TableColumn fx:id="colunaDivDiferenca" text="Diferença" prefWidth="100" styleClass="coluna-numero"/>
                                <TableColumn fx:id="colunaDivCusto" text="Custo" prefWidth="100" styleClass="coluna-numero"/>
                                <TableColumn fx:id="colunaDivValor" text="Valor da diferença" prefWidth="140" styleClass="coluna-numero"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                        </TableView>
                        <GridPane hgap="28" vgap="2" styleClass="painel-formulario">
                            <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
                            <Label text="Sobra" styleClass="subtitulo" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label text="Falta" styleClass="subtitulo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Resultado" styleClass="subtitulo" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                            <Label text="Não contados" styleClass="subtitulo" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                            <Label fx:id="totalSobra" text="—" styleClass="valor-destaque" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Label fx:id="totalFalta" text="—" styleClass="valor-destaque" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label fx:id="totalResultado" text="—" styleClass="valor-destaque" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                            <Label fx:id="totalNaoContados" text="—" styleClass="valor-destaque" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                            <Label fx:id="detalheSobra" styleClass="subtitulo" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label fx:id="detalheFalta" styleClass="subtitulo" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <Label fx:id="detalheResultado" styleClass="subtitulo" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                            <Label fx:id="detalheNaoContados" styleClass="subtitulo" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                        </GridPane>
                    </VBox>
                </Tab>
            </TabPane>
            <Label fx:id="mensagem" wrapText="true"/>
        </VBox>
    </SplitPane>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Ctrl+N novo inventário · Contar: leia o código (Enter) e digite o contado (Enter grava) · Recontagem sobrescreve a anterior"
               styleClass="subtitulo"/>
    </HBox>
</VBox>
