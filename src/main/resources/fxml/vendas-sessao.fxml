<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Vendas da sessão de caixa aberta (F9, 6.6): reimprimir o comprovante ou cancelar a venda (CANCELAR_VENDA ou
     liberação de supervisor, motivo obrigatório). Enter abre o comprovante; Delete cancela; Esc fecha. -->
<VBox fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.VendasSessaoController"
      spacing="10" styleClass="tela-cadastro" prefWidth="760" prefHeight="480">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <Label fx:id="titulo" styleClass="titulo"/>
    <TableView fx:id="tabelaVendas" VBox.vgrow="ALWAYS">
        <placeholder><Label text="Nenhuma venda nesta sessão de caixa."/></placeholder>
        <columns>
            <TableColumn fx:id="colunaNumero" text="Venda nº" prefWidth="90" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaHora" text="Data/hora" prefWidth="140"/>
            <TableColumn fx:id="colunaOperador" text="Operador" prefWidth="180"/>
            <TableColumn fx:id="colunaItens" text="Itens" prefWidth="60" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaTotal" text="Total" prefWidth="110" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaSituacao" text="Situação" prefWidth="110"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
    </TableView>
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="botaoComprovante" text="Ver comprovante (Enter)" onAction="#verComprovante"/>
        <Button fx:id="botaoCancelar" text="Cancelar venda… (Delete)" onAction="#cancelarVenda"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Fechar (Esc)" onAction="#fechar" cancelButton="true"/>
    </HBox>
    <Label fx:id="mensagem" wrapText="true"/>
</VBox>
