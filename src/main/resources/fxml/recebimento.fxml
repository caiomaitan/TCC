<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Recebimento do crediário (F14.3), aberto pela tela Caixa e pelo PDV (Ctrl+R): cliente, títulos com encargos, valor
     aplicado do vencimento mais antigo para o mais novo, desconto nos encargos e pagamento como no PDV. -->
<VBox fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.RecebimentoController"
      spacing="10" prefWidth="860" prefHeight="660">
    <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

    <Label text="Receber crediário" styleClass="titulo"/>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Cliente" minWidth="-Infinity"/>
        <TextField fx:id="campoBusca" promptText="Nome, CPF/CNPJ ou telefone (Enter)" prefWidth="280"
                   onAction="#pesquisar"/>
        <ComboBox fx:id="campoCliente" prefWidth="380" promptText="Escolha o cliente"/>
    </HBox>

    <Label text="Selecione os títulos ou digite um valor: ele é aplicado do vencimento mais antigo para o mais novo."
           styleClass="subtitulo" wrapText="true" minHeight="-Infinity"/>
    <TableView fx:id="tabelaTitulos" VBox.vgrow="ALWAYS" minHeight="130">
        <placeholder><Label text="Nenhum título em aberto."/></placeholder>
        <columns>
            <TableColumn fx:id="colunaVenda" text="Venda" prefWidth="70" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaParcela" text="Parcela" prefWidth="60"/>
            <TableColumn fx:id="colunaVencimento" text="Vencimento" prefWidth="100"/>
            <TableColumn fx:id="colunaAtraso" text="Atraso (dias)" prefWidth="90" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaEmAberto" text="Em aberto" prefWidth="100" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaMulta" text="Multa" prefWidth="80" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaJuros" text="Juros" prefWidth="80" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaQuitar" text="Para quitar" prefWidth="110" styleClass="coluna-numero"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
    </TableView>

    <HBox spacing="20">
        <GridPane hgap="10" vgap="6" styleClass="painel-formulario" HBox.hgrow="ALWAYS">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Valor a receber" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="campoValor" prefWidth="110" styleClass="campo-numero" onAction="#aplicarValor"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Desconto nos encargos" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="campoDesconto" prefWidth="110" styleClass="campo-numero" onAction="#aplicarValor"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Principal" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="principal" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Multa" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="multa" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Juros" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="juros" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Total" styleClass="titulo-secao" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <Label fx:id="total" styleClass="valor-destaque" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        </GridPane>

        <VBox spacing="6" styleClass="painel-formulario" HBox.hgrow="ALWAYS">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <ComboBox fx:id="forma" prefWidth="170"/>
                <TextField fx:id="valor" prefWidth="100" styleClass="campo-numero" onAction="#adicionar"/>
                <Button fx:id="botaoAdicionar" text="Adicionar" onAction="#adicionar"/>
            </HBox>
            <TableView fx:id="tabelaPagamentos" prefHeight="80">
                <placeholder><Label text="Nenhum pagamento informado."/></placeholder>
                <columns>
                    <TableColumn fx:id="colunaForma" text="Forma" prefWidth="170"/>
                    <TableColumn fx:id="colunaPago" text="Valor" prefWidth="100" styleClass="coluna-numero"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            </TableView>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Pago"/>
                <Label fx:id="pago"/>
                <Label text="Falta"/>
                <Label fx:id="falta"/>
                <Label text="Troco"/>
                <Label fx:id="troco" styleClass="titulo-secao"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="botaoRemover" text="Remover" onAction="#remover"/>
            </HBox>
        </VBox>
    </HBox>

    <Label fx:id="mensagem" wrapText="true" minHeight="-Infinity"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" cancelButton="true" onAction="#cancelar"/>
        <Button fx:id="botaoConfirmar" text="Confirmar recebimento" disable="true" onAction="#confirmar"
                styleClass="botao-primario"/>
    </HBox>
</VBox>
