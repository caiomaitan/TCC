<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Relatórios (Fig. 22 revisada, 7.4): escolher o relatório → só os filtros dele → Gerar (em Task) → tabela com
     linha de totais → Exportar CSV ou PDF. As colunas da tabela vêm da definição do relatório. -->
<VBox fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.RelatoriosController"
      spacing="10" styleClass="tela-cadastro">

    <Label text="Relatórios" styleClass="titulo"/>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Relatório:" minWidth="-Infinity"/>
        <ComboBox fx:id="escolhaRelatorio" prefWidth="340" minWidth="-Infinity"/>
        <Label fx:id="descricao" wrapText="true" styleClass="subtitulo" HBox.hgrow="ALWAYS"/>
    </HBox>

    <FlowPane hgap="18" vgap="8" styleClass="painel-formulario">
        <HBox fx:id="grupoPeriodo" alignment="CENTER_LEFT" spacing="6">
            <Label text="Período:"/>
            <DatePicker fx:id="dataInicio" prefWidth="130"/>
            <Label text="a"/>
            <DatePicker fx:id="dataFim" prefWidth="130"/>
        </HBox>
        <HBox fx:id="grupoOperador" alignment="CENTER_LEFT" spacing="6">
            <Label text="Operador:"/>
            <ComboBox fx:id="escolhaOperador" prefWidth="200"/>
        </HBox>
        <HBox fx:id="grupoCategoria" alignment="CENTER_LEFT" spacing="6">
            <Label text="Categoria:"/>
            <ComboBox fx:id="escolhaCategoria" prefWidth="200"/>
        </HBox>
        <HBox fx:id="grupoFornecedor" alignment="CENTER_LEFT" spacing="6">
            <Label text="Fornecedor:"/>
            <ComboBox fx:id="escolhaFornecedor" prefWidth="240"/>
        </HBox>
        <HBox fx:id="grupoProduto" alignment="CENTER_LEFT" spacing="6">
            <Label text="Produto:"/>
            <TextField fx:id="campoProduto" promptText="Código ou código de barras (vazio = todos)"
                       prefWidth="280"/>
        </HBox>
        <HBox fx:id="grupoTipo" alignment="CENTER_LEFT" spacing="6">
            <Label text="Tipo:"/>
            <ComboBox fx:id="escolhaTipo" prefWidth="200"/>
        </HBox>
        <HBox fx:id="grupoCriterio" alignment="CENTER_LEFT" spacing="6">
            <Label text="Critério:"/>
            <ComboBox fx:id="escolhaCriterio" prefWidth="140"/>
        </HBox>
        <HBox fx:id="grupoTopN" alignment="CENTER_LEFT" spacing="6">
            <Label text="Mostrar os"/>
            <TextField fx:id="campoTopN" prefWidth="60" styleClass="campo-numero" promptText="todos"/>
            <Label text="primeiros"/>
        </HBox>
        <HBox fx:id="grupoDias" alignment="CENTER_LEFT" spacing="6">
            <Label text="Sem venda há"/>
            <TextField fx:id="campoDias" prefWidth="60" styleClass="campo-numero"/>
            <Label text="dias ou mais"/>
        </HBox>
        <HBox fx:id="grupoValidade" alignment="CENTER_LEFT" spacing="6">
            <Label text="Vencem em até"/>
            <TextField fx:id="campoDiasValidade" prefWidth="60" styleClass="campo-numero"/>
            <Label text="dias"/>
            <CheckBox fx:id="filtroVencidos" text="Incluir os vencidos"/>
        </HBox>
        <HBox fx:id="grupoRegraFiscal" alignment="CENTER_LEFT" spacing="6">
            <Label text="Regra:"/>
            <ComboBox fx:id="escolhaRegraFiscal" prefWidth="300"/>
        </HBox>
        <HBox fx:id="grupoSituacao" alignment="CENTER_LEFT" spacing="6">
            <Label text="Situação:"/>
            <ComboBox fx:id="escolhaSituacao" prefWidth="140"/>
        </HBox>
        <HBox fx:id="grupoCliente" alignment="CENTER_LEFT" spacing="6">
            <Label text="Cliente:"/>
            <TextField fx:id="campoCliente" promptText="Nome ou CPF/CNPJ (vazio = todos)" prefWidth="240"/>
        </HBox>
        <HBox fx:id="grupoVencimento" alignment="CENTER_LEFT" spacing="6">
            <Label text="Vencimento:"/>
            <DatePicker fx:id="vencimentoDe" prefWidth="130"/>
            <Label text="a"/>
            <DatePicker fx:id="vencimentoAte" prefWidth="130"/>
        </HBox>
        <HBox fx:id="grupoForma" alignment="CENTER_LEFT" spacing="6">
            <Label text="Forma:"/>
            <ComboBox fx:id="escolhaForma" prefWidth="200"/>
        </HBox>
        <HBox fx:id="grupoCategoriaDespesa" alignment="CENTER_LEFT" spacing="6">
            <Label text="Categoria:"/>
            <ComboBox fx:id="escolhaCategoriaDespesa" prefWidth="200"/>
        </HBox>
        <HBox fx:id="grupoAgrupamento" alignment="CENTER_LEFT" spacing="6">
            <Label text="Visão por:"/>
            <ComboBox fx:id="escolhaAgrupamento" prefWidth="110"/>
        </HBox>
        <HBox fx:id="grupoMes" alignment="CENTER_LEFT" spacing="6">
            <Label text="Mês:"/>
            <ComboBox fx:id="escolhaMes" prefWidth="160"/>
        </HBox>
        <CheckBox fx:id="filtroAbaixoMinimo" text="Só abaixo do mínimo"/>
        <CheckBox fx:id="filtroInativos" text="Incluir inativos"/>
        <CheckBox fx:id="filtroDetalhar" text="Detalhar por venda"/>
    </FlowPane>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="botaoGerar" text="Gerar" onAction="#gerar" styleClass="botao-primario" defaultButton="true"/>
        <ProgressIndicator fx:id="progresso" visible="false" prefWidth="22" prefHeight="22"/>
        <Label fx:id="mensagem" wrapText="true"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="botaoAbrirProduto" text="Abrir produto…" onAction="#abrirProduto" disable="true"
                minWidth="-Infinity"/>
        <Button fx:id="botaoCsv" text="Exportar CSV…" onAction="#exportarCsv" disable="true" minWidth="-Infinity"/>
        <Button fx:id="botaoPdf" text="Exportar PDF…" onAction="#exportarPdf" disable="true" minWidth="-Infinity"/>
    </HBox>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <placeholder><Label fx:id="semDados" text="Escolha os filtros e clique em Gerar."/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/></columnResizePolicy>
    </TableView>
    <HBox fx:id="linhaTotais" styleClass="linha-totais"/>
</VBox>
