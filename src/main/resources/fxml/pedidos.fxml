<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Compras, aba Pedidos (F16.3): lista de pedidos de compra por fornecedor e situação; itens do pedido escolhido
     (só o rascunho muda); enviar, PDF e cancelar. Ctrl+N cria um pedido. -->
<VBox fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.PedidosController" spacing="10">
    <padding><Insets top="10" right="2" bottom="2" left="2"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <FlowPane alignment="CENTER_LEFT" hgap="10" vgap="8" prefWrapLength="900" HBox.hgrow="ALWAYS">
            <Label text="Fornecedor"/>
            <ComboBox fx:id="filtroFornecedor" prefWidth="240" onAction="#pesquisar"/>
            <Label text="Situação"/>
            <ComboBox fx:id="filtroSituacao" prefWidth="200" onAction="#pesquisar"/>
        </FlowPane>
        <Button text="Novo pedido… (Ctrl+N)" onAction="#novo" styleClass="botao-primario" minWidth="-Infinity"/>
    </HBox>

    <SplitPane orientation="VERTICAL" dividerPositions="0.32" VBox.vgrow="ALWAYS">
        <TableView fx:id="tabelaPedidos">
            <placeholder><Label fx:id="semPedidos" text="Nenhum pedido. Crie um em &quot;Novo pedido…&quot; ou pela Sugestão de compra."/></placeholder>
            <columns>
                <TableColumn fx:id="colunaNumero" text="Nº" prefWidth="50" styleClass="coluna-numero"/>
                <TableColumn fx:id="colunaFornecedor" text="Fornecedor" prefWidth="220"/>
                <TableColumn fx:id="colunaSituacao" text="Situação" prefWidth="80"/>
                <TableColumn fx:id="colunaCriado" text="Criado em" prefWidth="120"/>
                <TableColumn fx:id="colunaEnviado" text="Enviado em" prefWidth="120"/>
                <TableColumn fx:id="colunaPrevisao" text="Previsão" prefWidth="85"/>
                <TableColumn fx:id="colunaItens" text="Itens" prefWidth="50" styleClass="coluna-numero"/>
                <TableColumn fx:id="colunaValor" text="Valor previsto" prefWidth="110" styleClass="coluna-numero"/>
                <TableColumn fx:id="colunaPendente" text="Falta receber" prefWidth="100" styleClass="coluna-numero"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        </TableView>

        <VBox spacing="8">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="tituloPedido" text="Selecione um pedido" styleClass="titulo-secao" minWidth="-Infinity"/>
                <FlowPane alignment="CENTER_RIGHT" hgap="10" vgap="8" prefWrapLength="900" HBox.hgrow="ALWAYS">
                <Button fx:id="botaoDados" text="Dados do pedido…" onAction="#editarDados" minWidth="-Infinity"/>
                <Button fx:id="botaoPdf" text="PDF do pedido…" onAction="#exportarPdf" minWidth="-Infinity"/>
                <Button fx:id="botaoCancelar" text="Cancelar pedido…" onAction="#cancelar" minWidth="-Infinity"/>
                <Button fx:id="botaoEnviar" text="Enviar pedido…" onAction="#enviar" styleClass="botao-primario"
                        minWidth="-Infinity"/>
                </FlowPane>
            </HBox>

            <Label fx:id="situacao" styleClass="subtitulo" wrapText="true" minHeight="-Infinity"/>
            <!-- Quebra a linha quando não cabe (fonte de 130%, F21.2). -->
            <FlowPane fx:id="painelItem" alignment="CENTER_LEFT" hgap="8" vgap="8" styleClass="painel-formulario">
                <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                <TextField fx:id="campoProduto" promptText="Código de barras, código ou nome (Enter)" prefWidth="230"
                           onAction="#escolherProduto"/>
                <Label fx:id="produtoEscolhido" text="Nenhum produto" styleClass="produto-contagem"
                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Label text="Qtd. *"/>
                <TextField fx:id="campoQuantidade" prefWidth="80" styleClass="campo-numero" onAction="#focarCusto"/>
                <Label text="Custo previsto *"/>
                <TextField fx:id="campoCusto" prefWidth="100" styleClass="campo-numero" onAction="#gravarItem"/>
                <Button fx:id="botaoGravarItem" text="Incluir" onAction="#gravarItem" minWidth="-Infinity"/>
                <Button text="Limpar" onAction="#limparItem" minWidth="-Infinity"/>
                <Button fx:id="botaoRemover" text="Remover…" onAction="#removerItem" minWidth="-Infinity"/>
            </FlowPane>

            <TableView fx:id="tabelaItens" VBox.vgrow="ALWAYS">
                <placeholder><Label fx:id="semItens" text="Nenhum item neste pedido."/></placeholder>
                <columns>
                    <TableColumn fx:id="colunaItemCodigo" text="Código" prefWidth="60" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaItemFornecedor" text="Cód. fornecedor" prefWidth="105"/>
                    <TableColumn fx:id="colunaItemProduto" text="Produto" prefWidth="220"/>
                    <TableColumn fx:id="colunaItemQuantidade" text="Quantidade" prefWidth="90" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaItemCompra" text="Un. compra" prefWidth="85" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaItemCusto" text="Custo previsto" prefWidth="105" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaItemValor" text="Valor" prefWidth="95" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaItemRecebida" text="Recebida" prefWidth="80" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaItemPendente" text="Falta" prefWidth="70" styleClass="coluna-numero"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="24">
                <Label fx:id="totalPedido" styleClass="valor-destaque"/>
                <Label fx:id="entradas" styleClass="subtitulo"/>
            </HBox>
            <Label fx:id="mensagem" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </SplitPane>

    <Label text="Só o rascunho muda: leia o código (Enter), digite a quantidade na unidade de venda (Enter) e o custo previsto (Enter inclui) · Enviado e parcial contam como pendente na Sugestão de compra e recebem entrada (Entradas › Pedido…)"
           styleClass="subtitulo,dica-atalhos" wrapText="true" minHeight="-Infinity"/>
</VBox>
