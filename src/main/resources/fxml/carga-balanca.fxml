<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Carga de balança (F18.2): os pesáveis com PLU, a situação de cada um e a gravação do ITENSMGV.TXT. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.CargaBalancaController"
      spacing="10" styleClass="tela-cadastro" prefWidth="1200" prefHeight="640">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

    <Label text="Carga de balança" styleClass="titulo"/>
    <Label text="Produtos ativos vendidos em KG que têm PLU, com o preço por kg de hoje (inclusive promoção). A carga leva sempre todos; em amarelo, os que mudaram desde a última."
           styleClass="subtitulo" wrapText="true" minHeight="-Infinity"/>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Arquivo:" minWidth="-Infinity"/>
        <Label fx:id="pasta" minWidth="0" textOverrun="LEADING_ELLIPSIS" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Label fx:id="ultimaCarga" styleClass="subtitulo" minWidth="-Infinity"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <CheckBox fx:id="campoSoPendentes" text="Mostrar só os pendentes"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Atualizar" onAction="#carregar"/>
    </HBox>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <placeholder><Label text="Nenhum produto pesável com PLU."/></placeholder>
        <columns>
            <TableColumn fx:id="colunaPlu" text="PLU" prefWidth="70" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaNome" text="Produto" prefWidth="250"/>
            <TableColumn fx:id="colunaDescricao" text="Descrição na balança" prefWidth="300"/>
            <TableColumn fx:id="colunaPreco" text="Preço por kg" prefWidth="140" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaValidade" text="Validade" prefWidth="80" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaUltima" text="Última carga" prefWidth="140"/>
            <TableColumn fx:id="colunaSituacao" text="Situação" prefWidth="140"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
    </TableView>

    <Label text="Linha do produto selecionado no arquivo (150 caracteres, formato MGV6 descrito no README, seção Balança):"
           styleClass="subtitulo"/>
    <Label fx:id="linhaArquivo" styleClass="texto-monoespacado"/>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="resumo" styleClass="subtitulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="botaoGerar" text="Gerar carga" onAction="#gerar" styleClass="botao-primario"/>
    </HBox>
    <Label fx:id="mensagem" wrapText="true" minHeight="-Infinity"/>
</VBox>
