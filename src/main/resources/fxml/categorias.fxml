<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Categorias de produto: lista + nome. Enter salva; Esc fecha. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.CategoriasController"
      spacing="10" prefWidth="560" prefHeight="480" styleClass="tela-cadastro">
    <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Categorias" styleClass="titulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nova categoria" onAction="#nova"/>
    </HBox>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colunaNome" text="Nome" prefWidth="330"/>
            <TableColumn fx:id="colunaSituacao" text="Situação" prefWidth="120"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="tituloFormulario" minWidth="110" styleClass="titulo-secao"/>
        <TextField fx:id="campoNome" promptText="Nome da categoria *" HBox.hgrow="ALWAYS"/>
    </HBox>

    <Label fx:id="mensagem" wrapText="true" minHeight="36" styleClass="mensagem"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="botaoExcluir" text="Excluir" onAction="#excluir"/>
        <Button fx:id="botaoSituacao" text="Inativar" onAction="#alternarSituacao"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Fechar" cancelButton="true" onAction="#fechar"/>
        <Button text="Salvar" defaultButton="true" onAction="#salvar" styleClass="botao-primario"/>
    </HBox>
</VBox>
