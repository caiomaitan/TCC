<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Configurações (6.13, só supervisor): loja, venda, relatórios, balança, formas de pagamento, diagnóstico do estoque
     (6.4), backup (6.12), auditoria e dados de demonstração (6.14). Loja, Venda, Relatórios, Balança e Backup são
     salvas juntas pelo botão "Salvar alterações". -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.ConfiguracoesController"
      spacing="10" styleClass="tela-cadastro">

    <Label text="Configurações" styleClass="titulo"/>

    <TabPane fx:id="abas" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab fx:id="abaLoja" text="Loja">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label wrapText="true" minHeight="-Infinity" text="Dados que aparecem no comprovante não fiscal, nos relatórios e no título do sistema."/>
                <GridPane hgap="12" vgap="10" maxWidth="720">
                    <columnConstraints>
                        <ColumnConstraints minWidth="190"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Nome da loja *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoNomeLoja" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="CNPJ ou CPF" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoDocumento" promptText="Opcional" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Endereço" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoEndereco" promptText="Rua, número, bairro, cidade" GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>
                    <Label text="Telefone" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoTelefone" promptText="(16) 3333-4444" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label text="Mensagem do comprovante" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoRodape" promptText="Ex.: Obrigado pela preferência!" GridPane.rowIndex="4"
                               GridPane.columnIndex="1"/>
                    <Label text="Regime tributário" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="campoRegime" prefWidth="220" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    <Label text="UF" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="campoUf" prefWidth="90" visibleRowCount="10" GridPane.rowIndex="6"
                              GridPane.columnIndex="1"/>
                    <Label text="Inscrição estadual" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoIe" promptText="Só os dígitos, ou ISENTO" maxWidth="220" GridPane.rowIndex="7"
                               GridPane.columnIndex="1"/>
                </GridPane>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="O regime, a UF e a IE preparam o cadastro fiscal (Produtos › Fiscal…): no Simples Nacional a situação do ICMS é o CSOSN; no regime normal, o CST. O sistema não emite documento fiscal."/>
            </VBox>
        </Tab>
        <Tab fx:id="abaVenda" text="Venda">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <CheckBox fx:id="campoEstoqueNegativo" text="Permitir vender produto sem saldo no estoque (o PDV só avisa)"/>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="Desmarcado, o PDV recusa o item quando o saldo não basta. Marcado (recomendado), a venda continua e o aviso lembra de conferir o estoque: o caixa não trava com o cliente na fila."/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Desconto máximo do operador (%)" minWidth="230"/>
                    <TextField fx:id="campoDescontoMaximo" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="Acima deste percentual da venda, o desconto pede a liberação de quem tem a permissão &quot;Desconto acima do limite&quot;."/>
                <CheckBox fx:id="campoCancelarItem" text="Cancelar item no PDV pede liberação de supervisor"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Prazo de devolução (dias)" minWidth="230"/>
                    <TextField fx:id="campoPrazoDevolucao" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="Depois deste prazo, contado da data da venda, a devolução pede a liberação de um supervisor (0 = sempre pede)."/>
            </VBox>
        </Tab>
        <Tab fx:id="abaRelatorios" text="Relatórios">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Margem mínima (%)" minWidth="230"/>
                    <TextField fx:id="campoMargemMinima" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="Abaixo desta margem o produto é de baixa rentabilidade (R05) e a entrada de mercadoria sugere reajuste do preço."/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Dias sem venda para &quot;sem giro&quot;" minWidth="230"/>
                    <TextField fx:id="campoDiasSemGiro" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="Valor inicial do relatório de produtos sem giro (R12)."/>
            </VBox>
        </Tab>
        <Tab fx:id="abaBalanca" text="Balança">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <CheckBox fx:id="campoBalancaAtiva" text="Ler etiquetas de balança no PDV"/>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="A etiqueta é um código EAN-13 que começa com o prefixo, seguido do código do produto na balança (PLU, informado no cadastro do produto) e do preço total ou do peso. Configure igual à balança."/>
                <GridPane hgap="12" vgap="10" maxWidth="720">
                    <columnConstraints>
                        <ColumnConstraints minWidth="230"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Prefixo (1º dígito)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoPrefixo" maxWidth="60" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Dígitos do código (PLU)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="campoDigitos" prefWidth="90" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="A etiqueta traz" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="campoTipoValor" prefWidth="220" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
                <Label fx:id="exemploEtiqueta" wrapText="true" minHeight="-Infinity" styleClass="subtitulo"/>
                <Label text="Carga de balança" styleClass="titulo-secao"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Pasta do arquivo de itens (MGV)" minWidth="230"/>
                    <TextField fx:id="campoPastaCarga" prefWidth="380" promptText="vazia = carga não configurada"/>
                    <Button text="Procurar…" onAction="#escolherPastaCarga"/>
                </HBox>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="Produtos › Carga de balança grava nesta pasta o arquivo ITENSMGV.TXT (formato do MGV6 da Toledo), com os produtos ativos vendidos em KG que têm PLU, o preço por kg do dia (com promoção), a descrição e os dias de validade. Use a pasta de onde o MGV importa os itens. O formato precisa ser conferido com o manual da balança da loja antes do uso."/>
            </VBox>
        </Tab>
        <Tab fx:id="abaSeguranca" text="Segurança">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Bloquear a tela depois de (minutos)" minWidth="230"/>
                    <TextField fx:id="campoInatividade" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="Sem teclado nem mouse por esse tempo, a janela principal e o PDV mostram a tela &quot;Sessão bloqueada&quot;: o que estava aberto continua como estava (inclusive a venda em andamento) e só volta com a senha de quem está logado. De 0 (não bloqueia) a 480. Vale a partir do próximo login."/>
                <Label text="Política de senha" styleClass="titulo-secao"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Tamanho mínimo da senha (caracteres)" minWidth="230"/>
                    <TextField fx:id="campoSenhaTamanho" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <CheckBox fx:id="campoSenhaLetraENumero" text="Exigir letras e números na senha"/>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="Vale para as senhas novas e trocadas (primeiro acesso, troca de senha e senha provisória do supervisor): de 6 a 50 caracteres e sempre diferente do login. As senhas atuais continuam valendo até a próxima troca."/>
            </VBox>
        </Tab>
        <Tab fx:id="abaFidelidade" text="Fidelidade">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <CheckBox fx:id="campoFidelidadeAtiva" text="Gerar cashback nas vendas com cliente identificado (F11)"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Cashback (% da venda)" minWidth="230"/>
                    <TextField fx:id="campoCashback" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Compra mínima (R$)" minWidth="230"/>
                    <TextField fx:id="campoCompraMinima" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="O cashback vira crédito do cliente na finalização: o percentual sobre o total da venda, sem o que foi pago com o próprio crédito, e só se esse valor for igual ou maior que a compra mínima. O cliente usa o crédito no pagamento, pela forma &quot;Crédito do cliente&quot;. Cancelar a venda estorna o cashback e devolve o crédito usado."/>
            </VBox>
        </Tab>
        <Tab fx:id="abaCrediario" text="Crediário">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Máximo de parcelas" minWidth="230"/>
                    <TextField fx:id="campoMaxParcelas" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Dias até a 1ª parcela" minWidth="230"/>
                    <TextField fx:id="campoDiasPrimeira" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Juros ao mês (%)" minWidth="230"/>
                    <TextField fx:id="campoJuros" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Multa por atraso (%)" minWidth="230"/>
                    <TextField fx:id="campoMulta" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Carência (dias sem encargos)" minWidth="230"/>
                    <TextField fx:id="campoCarencia" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Atraso que pede liberação (dias)" minWidth="230"/>
                    <TextField fx:id="campoBloqueioAtraso" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="As parcelas vencem de 30 em 30 dias a partir da primeira. Multa e juros simples valem para os títulos com atraso maior que a carência. Cliente com título vencido há mais dias que o informado só compra a prazo com a liberação de quem tem a permissão de gerenciar crédito. O limite e o bloqueio de cada cliente ficam na tela Clientes, aba Crediário."/>
            </VBox>
        </Tab>
        <Tab fx:id="abaFinanceiro" text="Financeiro">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <CheckBox fx:id="campoIntegrarCaixa" text="Integrar o caixa com as contas financeiras"/>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="Ligada, a abertura retira o fundo de troco de uma conta, a sangria entra numa conta, o suprimento sai de uma conta e o fechamento leva o dinheiro contado para uma conta. Ligue depois de lançar o saldo inicial das contas (menu Financeiro). Vale para os caixas abertos depois de ligar; um caixa continua como foi aberto até o fechamento."/>
            </VBox>
        </Tab>
        <Tab fx:id="abaCompras" text="Compras">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Dias de venda na média diária" minWidth="230"/>
                    <TextField fx:id="campoDiasMedia" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Cobertura desejada (dias)" minWidth="230"/>
                    <TextField fx:id="campoCobertura" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="A sugestão de compra (tela Compras) usa a venda dos últimos dias, já sem as devoluções, para calcular a média por dia, e sugere o que falta para cobrir os dias de cobertura mais o prazo de entrega do fornecedor principal, sem ficar abaixo do estoque mínimo. O fornecedor principal, o prazo e o fator de cada produto ficam no cadastro do produto, aba Fornecedores."/>
            </VBox>
        </Tab>
        <Tab fx:id="abaEstoque" text="Estoque">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Alerta de validade (dias antes)" minWidth="230"/>
                    <TextField fx:id="campoAlertaValidade" prefWidth="90" styleClass="campo-numero"/>
                </HBox>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="Nos produtos com o controle de validade e lotes ligado (cadastro do produto), o lote com saldo que vence em até estes dias aparece em amarelo na aba Lotes do Estoque e entra no alerta do Painel e no relatório R29 Validade. Os lotes vencidos com saldo aparecem em vermelho até a perda por vencimento ou o inventário."/>
            </VBox>
        </Tab>
        <Tab fx:id="abaEtiquetas" text="Etiquetas">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Folha A4: etiquetas por linha" minWidth="230"/>
                    <TextField fx:id="campoEtiquetaColunas" prefWidth="60" styleClass="campo-numero"/>
                    <Label text="linhas por folha"/>
                    <TextField fx:id="campoEtiquetaLinhas" prefWidth="60" styleClass="campo-numero"/>
                    <Label styleClass="subtitulo" text="(de 1 a 6 por linha e de 1 a 20 linhas; padrão 3 × 8)"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Impressora térmica" minWidth="230"/>
                    <ComboBox fx:id="campoImpressoraTermica" editable="true" prefWidth="320"/>
                    <Button fx:id="botaoImprimirTeste" text="Imprimir teste" onAction="#imprimirTeste"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Modelo da etiqueta (ZPL ou DPL)" minWidth="230"/>
                    <Button text="Exemplo ZPL (Zebra)" onAction="#exemploZpl"/>
                    <Button text="Exemplo DPL (Datamax e Allegro)" onAction="#exemploDpl"/>
                </HBox>
                <TextArea fx:id="campoModeloTermica" prefRowCount="11" VBox.vgrow="ALWAYS" styleClass="texto-modelo"/>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="Variáveis: {NOME} (ou {NOME:30}, cortado em 30 caracteres), {PRECO}, {PRECO_DE} (preço normal, só na promoção), {UNIDADE}, {CODBARRAS}, {PLU}, {CODIGO}, {VALIDADE} (fim da promoção), {QTD_ATACADO} e {PRECO_ATACADO} (a faixa de atacado, vazias sem faixa). Os preços saem sem &quot;R$&quot; (12,90), o que não se aplica sai vazio, o texto vai sem acentos e &lt;STX&gt; vira o caractere STX do DPL. Uma etiqueta por unidade da quantidade. Os exemplos são um ponto de partida: confira-os na impressora da loja com &quot;Imprimir teste&quot;, que usa o modelo e a impressora como estão na tela."/>
                <Label fx:id="mensagemEtiquetas" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </Tab>
        <Tab fx:id="abaFormas" text="Formas de pagamento">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label wrapText="true" minHeight="-Infinity" text="Formas que aparecem no pagamento do PDV. Desativar não apaga as vendas já pagas com a forma; sempre fica ao menos uma ativa. Só o tipo Dinheiro aceita troco e entra no dinheiro da gaveta."/>
                <TableView fx:id="tabelaFormas" VBox.vgrow="ALWAYS" maxWidth="720">
                    <columns>
                        <TableColumn fx:id="colunaFormaDescricao" text="Descrição" prefWidth="280"/>
                        <TableColumn fx:id="colunaFormaTipo" text="Tipo" prefWidth="180"/>
                        <TableColumn fx:id="colunaFormaSituacao" text="Situação" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                </TableView>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="botaoSituacaoForma" text="Desativar" onAction="#alternarForma"/>
                </HBox>
                <HBox fx:id="painelRecebimento" spacing="10" alignment="CENTER_LEFT">
                    <Label text="Recebimento:"/>
                    <Label text="Taxa (%)"/>
                    <TextField fx:id="campoTaxaForma" prefWidth="70" styleClass="campo-numero"/>
                    <Label text="Dias para receber"/>
                    <TextField fx:id="campoDiasForma" prefWidth="60" styleClass="campo-numero"/>
                    <Label text="Conta de destino"/>
                    <ComboBox fx:id="campoContaForma" prefWidth="180" promptText="Sem conta"/>
                    <Button text="Limpar conta" onAction="#limparContaForma"/>
                    <Button text="Salvar recebimento" onAction="#salvarRecebimentoForma"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Nova forma:"/>
                    <TextField fx:id="campoNovaForma" promptText="Descrição *" prefWidth="260" onAction="#criarForma"/>
                    <ComboBox fx:id="campoTipoForma" prefWidth="180"/>
                    <Button text="Criar" onAction="#criarForma"/>
                </HBox>
                <Label fx:id="mensagemFormas" wrapText="true" minHeight="-Infinity" styleClass="mensagem"/>
            </VBox>
        </Tab>
        <Tab fx:id="abaBackup" text="Backup">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label wrapText="true" minHeight="-Infinity" text="Cópia do banco de dados com o pg_dump do PostgreSQL. Além do botão abaixo, o sistema faz um backup automático ao sair, no máximo um por dia. Guarde cópias também fora deste computador (pen drive, nuvem)."/>
                <GridPane hgap="12" vgap="10" maxWidth="900">
                    <columnConstraints>
                        <ColumnConstraints minWidth="190"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints/>
                    </columnConstraints>
                    <Label text="Pasta dos backups" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoPastaBackup" promptText="Vazio = pasta padrão" GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>
                    <Button text="Escolher…" onAction="#escolherPastaBackup" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <Label text="Programa pg_dump" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoPgDump" promptText="Vazio = procurar automaticamente" GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>
                    <Button text="Escolher…" onAction="#escolherPgDump" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <Label text="Manter os últimos" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="1">
                        <TextField fx:id="campoManterBackups" prefWidth="70" styleClass="campo-numero"/>
                        <Label text="backups (os mais antigos são apagados)"/>
                    </HBox>
                </GridPane>
                <Label fx:id="situacaoPgDump" wrapText="true" minHeight="-Infinity" styleClass="subtitulo"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="botaoFazerBackup" text="Fazer backup agora" onAction="#fazerBackup"
                            styleClass="botao-primario" minWidth="-Infinity"/>
                    <ProgressIndicator fx:id="progressoBackup" visible="false" prefWidth="22" prefHeight="22"/>
                    <Label fx:id="resultadoBackup" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"
                           maxWidth="Infinity"/>
                </HBox>
                <Label fx:id="ultimoBackup" styleClass="titulo-secao"/>
                <TableView fx:id="tabelaBackups" VBox.vgrow="ALWAYS" maxWidth="900">
                    <placeholder><Label text="Nenhum backup nesta pasta."/></placeholder>
                    <columns>
                        <TableColumn fx:id="colunaBackupArquivo" text="Arquivo" prefWidth="320"/>
                        <TableColumn fx:id="colunaBackupTamanho" text="Tamanho" prefWidth="110" styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaBackupData" text="Gravado em" prefWidth="160"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                </TableView>
                <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="Restaurar um backup é feito fora do sistema, com o VareSync fechado em todos os computadores: veja o passo a passo no README (pg_restore --clean --if-exists -d varesync arquivo.backup)."/>
            </VBox>
        </Tab>
        <Tab fx:id="abaAuditoria" text="Auditoria">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="De"/>
                    <DatePicker fx:id="auditoriaInicio" prefWidth="130"/>
                    <Label text="até"/>
                    <DatePicker fx:id="auditoriaFim" prefWidth="130"/>
                    <Label text="Usuário"/>
                    <ComboBox fx:id="auditoriaUsuario" prefWidth="210"/>
                    <Label text="Ação"/>
                    <ComboBox fx:id="auditoriaAcao" prefWidth="230"/>
                    <Button fx:id="botaoConsultarAuditoria" text="Consultar" onAction="#consultarAuditoria"
                            styleClass="botao-primario" minWidth="-Infinity"/>
                    <ProgressIndicator fx:id="progressoAuditoria" visible="false" prefWidth="22" prefHeight="22"/>
                </HBox>
                <TableView fx:id="tabelaAuditoria" VBox.vgrow="ALWAYS">
                    <placeholder><Label text="Nenhum registro no filtro."/></placeholder>
                    <columns>
                        <TableColumn fx:id="colunaAuditoriaData" text="Data e hora" prefWidth="140"/>
                        <TableColumn fx:id="colunaAuditoriaUsuario" text="Usuário" prefWidth="170"/>
                        <TableColumn fx:id="colunaAuditoriaAcao" text="Ação" prefWidth="170"/>
                        <TableColumn fx:id="colunaAuditoriaDescricao" text="Descrição" prefWidth="560"/>
                        <TableColumn fx:id="colunaAuditoriaTerminal" text="Terminal" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                </TableView>
                <Label fx:id="detalheAuditoria" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="resumoAuditoria" wrapText="true" minHeight="-Infinity" styleClass="subtitulo"/>
            </VBox>
        </Tab>
        <Tab text="Diagnóstico">
            <ScrollPane fitToWidth="true" styleClass="painel-formulario">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label wrapText="true" minHeight="-Infinity" text="Confere se o saldo de cada produto é igual à soma de todos os seus movimentos de estoque; o saldo de crédito de cada cliente, à soma do seu extrato; o abatido de cada título e de cada devolução, à soma dos abatimentos por parcela; e o saldo de cada lote, à soma do seu razão (e, nos produtos com controle de validade, a soma dos lotes, ao saldo do produto). O esperado é não haver nenhuma diferença: os saldos só mudam por movimento."/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="botaoVerificar" text="Verificar agora" onAction="#verificar"
                            styleClass="botao-primario"/>
                    <ProgressIndicator fx:id="progresso" visible="false" prefWidth="22" prefHeight="22"/>
                    <Label fx:id="resultado" wrapText="true"/>
                </HBox>
                <TableView fx:id="tabelaInconsistencias" VBox.vgrow="ALWAYS" minHeight="90" prefHeight="140">
                    <placeholder><Label text="Nenhuma diferença encontrada."/></placeholder>
                    <columns>
                        <TableColumn fx:id="colunaProduto" text="Produto" prefWidth="320"/>
                        <TableColumn fx:id="colunaRegistrado" text="Saldo registrado" prefWidth="140"
                                     styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaMovimentos" text="Soma dos movimentos" prefWidth="160"
                                     styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaDiferenca" text="Diferença" prefWidth="120"
                                     styleClass="coluna-numero"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                </TableView>
                <Label text="Crédito dos clientes" styleClass="titulo-secao"/>
                <Label fx:id="resultadoCredito" wrapText="true" minHeight="-Infinity"/>
                <TableView fx:id="tabelaCredito" VBox.vgrow="ALWAYS" minHeight="120" prefHeight="160">
                    <placeholder><Label text="Nenhuma diferença encontrada."/></placeholder>
                    <columns>
                        <TableColumn fx:id="colunaCreditoCliente" text="Cliente" prefWidth="320"/>
                        <TableColumn fx:id="colunaCreditoRegistrado" text="Saldo registrado" prefWidth="140"
                                     styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaCreditoMovimentos" text="Soma do extrato" prefWidth="160"
                                     styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaCreditoDiferenca" text="Diferença" prefWidth="120"
                                     styleClass="coluna-numero"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                </TableView>
                <Label text="Abatimentos do crediário" styleClass="titulo-secao"/>
                <Label fx:id="resultadoAbatimento" wrapText="true" minHeight="-Infinity"/>
                <TableView fx:id="tabelaAbatimento" VBox.vgrow="ALWAYS" minHeight="90" prefHeight="110">
                    <placeholder><Label text="Nenhuma diferença encontrada."/></placeholder>
                    <columns>
                        <TableColumn fx:id="colunaAbatimentoOrigem" text="Título ou devolução" prefWidth="320"/>
                        <TableColumn fx:id="colunaAbatimentoValor" text="Abatido" prefWidth="140"
                                     styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaAbatimentoSoma" text="Soma das linhas" prefWidth="160"
                                     styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaAbatimentoDiferenca" text="Diferença" prefWidth="120"
                                     styleClass="coluna-numero"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                </TableView>
                <Label text="Contas financeiras" styleClass="titulo-secao"/>
                <Label fx:id="resultadoConta" wrapText="true" minHeight="-Infinity"/>
                <TableView fx:id="tabelaConta" VBox.vgrow="ALWAYS" minHeight="90" prefHeight="110">
                    <placeholder><Label text="Nenhuma diferença encontrada."/></placeholder>
                    <columns>
                        <TableColumn fx:id="colunaContaNome" text="Conta" prefWidth="320"/>
                        <TableColumn fx:id="colunaContaRegistrado" text="Saldo registrado" prefWidth="140"
                                     styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaContaMovimentos" text="Pelos movimentos" prefWidth="160"
                                     styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaContaDiferenca" text="Diferença" prefWidth="120"
                                     styleClass="coluna-numero"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                </TableView>
                <Label text="Lotes (validade)" styleClass="titulo-secao"/>
                <Label fx:id="resultadoLotes" wrapText="true" minHeight="-Infinity"/>
                <ListView fx:id="listaLotes" VBox.vgrow="ALWAYS" minHeight="70" prefHeight="90">
                    <placeholder><Label text="Nenhuma diferença encontrada."/></placeholder>
                </ListView>
            </VBox>
            </ScrollPane>
        </Tab>
        <Tab text="Dados de demonstração">
            <VBox spacing="10" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label wrapText="true" minHeight="-Infinity" text="Preenche um banco vazio com 60 dias de operação de um mercado fictício, terminando ontem: cerca de 80 produtos com estoque, 3 usuários (2 operadores de caixa e 1 gerente), um caixa por dia com vendas, sangrias e fechamento, descontos, cancelamentos, perdas, reajustes de preço e um inventário. Tudo passa pelas regras do sistema. Só funciona num banco sem vendas: use um banco separado para a demonstração (veja o README)."/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="botaoGerarDemo" text="Gerar dados de demonstração…" onAction="#gerarDemo"
                            styleClass="botao-primario"/>
                    <ProgressBar fx:id="progressoDemo" visible="false" prefWidth="260"/>
                </HBox>
                <Label fx:id="situacaoDemo" wrapText="true" minHeight="-Infinity"/>
                <TextArea fx:id="resultadoDemo" editable="false" wrapText="true" visible="false" managed="false"
                          prefRowCount="9" styleClass="comprovante"/>
            </VBox>
        </Tab>
    </TabPane>

    <HBox fx:id="barraSalvar" spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="mensagemParametros" wrapText="true" minHeight="-Infinity" styleClass="mensagem"
               HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Desfazer" onAction="#desfazer" minWidth="-Infinity"/>
        <Button fx:id="botaoSalvar" text="Salvar alterações" onAction="#salvar" styleClass="botao-primario"
                minWidth="-Infinity"/>
    </HBox>
</VBox>
