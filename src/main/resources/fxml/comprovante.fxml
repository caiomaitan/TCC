<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Comprovante não fiscal (6.6) em tela: Imprimir (F5, impressora padrão) e "Salvar PDF…"; Esc fecha. -->
<VBox fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.ComprovanteController"
      spacing="10" styleClass="tela-cadastro">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <HBox spacing="12" VBox.vgrow="ALWAYS">
        <TextArea fx:id="texto" editable="false" prefColumnCount="50" prefRowCount="30" styleClass="comprovante"
                  HBox.hgrow="ALWAYS"/>
        <!-- DANFE NFC-e (F23.7): o QR Code da consulta; vazio, não ocupa espaço -->
        <ImageView fx:id="qrCode" fitWidth="180" fitHeight="180" preserveRatio="true" managed="false" visible="false"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="botaoImprimir" text="Imprimir (F5)" onAction="#imprimir" styleClass="botao-primario"/>
        <Button fx:id="botaoPdf" text="Salvar PDF…" onAction="#salvarPdf"/>
        <ProgressIndicator fx:id="progresso" visible="false" prefWidth="22" prefHeight="22"/>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Só pela busca global (F21.3), para quem tem DEVOLUCAO. -->
        <Button fx:id="botaoDevolver" text="Devolver itens…" onAction="#devolver" visible="false" managed="false"/>
        <Button fx:id="botaoFechar" text="Fechar (Esc)" onAction="#fechar" defaultButton="true" cancelButton="true"/>
    </HBox>
    <Label fx:id="mensagem" wrapText="true" maxWidth="460"/>
</VBox>
