<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Notas fiscais (F23.9), aba da janela Cadastro fiscal (permissão FISCAL): as NFC-e com filtro por período,
     situação e número; Ver DANFE, Salvar XML, Transmitir agora, Corrigir e reenviar a rejeitada, Inutilizar números e
     Exportar XML do mês (ZIP para o contador). A NFC-e só é emitida em homologação, sem valor fiscal. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.NotasFiscaisController" spacing="8" fx:id="raiz">
    <padding><Insets top="10" right="0" bottom="0" left="0"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="De" minWidth="-Infinity"/>
        <DatePicker fx:id="campoDe" prefWidth="125" minWidth="-Infinity"/>
        <Label text="até" minWidth="-Infinity"/>
        <DatePicker fx:id="campoAte" prefWidth="125" minWidth="-Infinity"/>
        <Label text="Situação" minWidth="-Infinity"/>
        <ComboBox fx:id="campoSituacao" prefWidth="190" minWidth="-Infinity"/>
        <Label text="Número" minWidth="-Infinity"/>
        <TextField fx:id="campoNumero" prefWidth="90" minWidth="60" onAction="#pesquisar"/>
        <Button fx:id="botaoBuscar" text="Buscar" onAction="#pesquisar" minWidth="-Infinity"/>
        <ProgressIndicator fx:id="progresso" visible="false" prefHeight="22" prefWidth="22" minWidth="-Infinity"/>
    </HBox>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <placeholder><Label text="Nenhuma NFC-e no filtro."/></placeholder>
        <columns>
            <TableColumn fx:id="colunaNumero" text="Número" prefWidth="70" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaSerie" text="Série" prefWidth="50" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaData" text="Data e hora" prefWidth="125"/>
            <TableColumn fx:id="colunaValor" text="Valor" prefWidth="95" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaConsumidor" text="Consumidor" prefWidth="130"/>
            <TableColumn fx:id="colunaSituacao" text="Situação" prefWidth="170"/>
            <TableColumn fx:id="colunaProtocolo" text="Protocolo" prefWidth="130"/>
            <TableColumn fx:id="colunaMensagem" text="Mensagem" prefWidth="320"/>
        </columns>
    </TableView>
    <Label fx:id="resumo" styleClass="subtitulo" wrapText="true" minHeight="-Infinity"/>

    <FlowPane hgap="8" vgap="6">
        <Button fx:id="botaoDanfe" text="Ver DANFE" onAction="#verDanfe"/>
        <Button fx:id="botaoXml" text="Salvar XML…" onAction="#salvarXml"/>
        <Button fx:id="botaoReenviar" text="Corrigir e reenviar" onAction="#reenviar"/>
        <Button fx:id="botaoTransmitir" text="Transmitir agora" onAction="#transmitirAgora"/>
        <Button fx:id="botaoInutilizar" text="Inutilizar números…" onAction="#inutilizar"/>
        <Button fx:id="botaoExportar" text="Exportar XML do mês…" onAction="#exportarMes"/>
    </FlowPane>
    <Label fx:id="mensagem" wrapText="true" minHeight="-Infinity"/>
</VBox>
