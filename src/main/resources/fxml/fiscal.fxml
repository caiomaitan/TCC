<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Cadastro fiscal (F19.2 e F19.3, permissão FISCAL), aberto pelo item Fiscal do menu (F19.5), pelo botão "Fiscal…" de
     Produtos e pelo "Abrir produto" do R30: dados fiscais de cada produto e aplicação do perfil em lote, perfis
     tributários e as tabelas NCM e CEST. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.FiscalController"
      spacing="10" styleClass="tela-cadastro" prefWidth="1180" prefHeight="700">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

    <Label text="Cadastro fiscal" styleClass="titulo"/>
    <Label fx:id="situacaoEmpresa" styleClass="subtitulo" wrapText="true" minHeight="-Infinity"/>

    <TabPane fx:id="abas" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab fx:id="abaProdutos" text="Produtos">
            <VBox spacing="10">
                <padding><Insets top="10" right="0" bottom="0" left="0"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <!-- No menu (área de conteúdo, F19.5) a barra é mais estreita: só a busca encolhe. -->
                    <TextField fx:id="campoBusca" promptText="Nome, código ou código de barras" HBox.hgrow="ALWAYS"
                               minWidth="110" onAction="#pesquisar"/>
                    <Label text="Categoria" minWidth="-Infinity"/>
                    <ComboBox fx:id="filtroCategoria" prefWidth="150" minWidth="-Infinity"/>
                    <Label text="Perfil" minWidth="-Infinity"/>
                    <ComboBox fx:id="filtroPerfil" prefWidth="150" minWidth="-Infinity"/>
                    <CheckBox fx:id="campoSoPendentes" text="Só sem NCM ou sem perfil" minWidth="-Infinity"/>
                    <CheckBox fx:id="campoInativos" text="Mostrar inativos" minWidth="-Infinity"/>
                    <Button text="Buscar" onAction="#pesquisar" minWidth="-Infinity"/>
                </HBox>
                <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
                    <placeholder><Label text="Nenhum produto encontrado."/></placeholder>
                    <columns>
                        <TableColumn fx:id="colunaCodigo" text="Código" prefWidth="65" styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaNome" text="Nome" prefWidth="290"/>
                        <TableColumn fx:id="colunaCategoria" text="Categoria" prefWidth="140"/>
                        <TableColumn fx:id="colunaNcm" text="NCM" prefWidth="95"/>
                        <TableColumn fx:id="colunaCest" text="CEST" prefWidth="85"/>
                        <TableColumn fx:id="colunaOrigem" text="Origem" prefWidth="170"/>
                        <TableColumn fx:id="colunaPerfil" text="Perfil tributário" prefWidth="180"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                </TableView>
                <Label fx:id="resumo" styleClass="subtitulo"/>
                <HBox spacing="16">
                    <VBox spacing="8" styleClass="painel-formulario" HBox.hgrow="ALWAYS">
                        <Label fx:id="tituloProduto" text="Produto selecionado" styleClass="subtitulo"/>
                        <GridPane fx:id="gradeProduto" hgap="10" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints minWidth="70"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="NCM" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <TextField fx:id="campoNcm" promptText="0000.00.00" prefWidth="110"/>
                                <Label fx:id="descricaoNcm" styleClass="subtitulo" maxWidth="330"/>
                            </HBox>
                            <Label text="CEST" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="campoCest" promptText="00.000.00" maxWidth="110" GridPane.rowIndex="1"
                                       GridPane.columnIndex="1"/>
                            <Label text="Origem" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="campoOrigem" prefWidth="380" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="Perfil" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="campoPerfil" prefWidth="380" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        </GridPane>
                        <HBox alignment="CENTER_LEFT">
                            <Button fx:id="botaoSalvar" text="Salvar dados fiscais" onAction="#salvar"
                                    styleClass="botao-primario"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="8" styleClass="painel-formulario" HBox.hgrow="ALWAYS">
                        <Label text="Aplicar perfil em lote" styleClass="subtitulo"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Perfil" minWidth="70"/>
                            <ComboBox fx:id="campoPerfilLote" prefWidth="300"/>
                        </HBox>
                        <fx:define><ToggleGroup fx:id="grupoAlvo"/></fx:define>
                        <RadioButton fx:id="alvoSelecao" text="Aos produtos selecionados na lista" toggleGroup="$grupoAlvo"
                                     selected="true"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <RadioButton fx:id="alvoCategoria" text="A toda a categoria" toggleGroup="$grupoAlvo"
                                         minWidth="170"/>
                            <ComboBox fx:id="campoCategoriaLote" prefWidth="200"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <RadioButton fx:id="alvoNcm" text="Ao NCM (ou começo dele)" toggleGroup="$grupoAlvo"
                                         minWidth="170"/>
                            <TextField fx:id="campoNcmLote" promptText="Ex.: 2203 ou 2203.00.00" prefWidth="200"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                            <Button fx:id="botaoAplicar" text="Aplicar perfil…" onAction="#aplicar"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </Tab>
        <Tab fx:id="abaPerfis" text="Perfis tributários">
            <fx:include fx:id="perfis" source="perfis-tributarios.fxml"/>
        </Tab>
        <Tab fx:id="abaTabelas" text="Tabelas NCM e CEST">
            <VBox spacing="12" styleClass="painel-formulario">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label wrapText="true" minHeight="-Infinity" text="Sem tabela importada, o sistema confere só o formato do NCM (8 dígitos) e do CEST (7 dígitos). Com a tabela, o código também tem de existir nela. Importar de novo troca a tabela inteira."/>
                <Label fx:id="situacaoNcm" styleClass="subtitulo"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="botaoImportarNcm" text="Importar tabela NCM (CSV ou JSON)…" onAction="#importarNcm"/>
                    <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="CSV com código;descrição, ou o JSON oficial da tabela NCM do Siscomex (códigos com pontos e níveis intermediários: só entram os de 8 dígitos)."/>
                </HBox>
                <Label fx:id="situacaoCest" styleClass="subtitulo"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="botaoImportarCest" text="Importar tabela CEST (CSV)…" onAction="#importarCest"/>
                    <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="CSV com cest;ncm;descrição. O NCM pode ser o começo do código (ex.: 2203) ou vários, separados por vírgula."/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ProgressIndicator fx:id="progresso" visible="false" prefWidth="24" prefHeight="24"/>
                    <Label fx:id="mensagemTabelas" wrapText="true" minHeight="-Infinity"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="mensagem" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="rotuloEsc" text="Esc fecha a janela." styleClass="subtitulo"/>
    </HBox>
</VBox>
