<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Cadastro de produto (Fig. 20 revisada): dados, códigos de barras, simulador e aba de histórico.
     Enter salva (no campo de código de barras, Enter adiciona o código); Esc fecha. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.ProdutoController"
      spacing="10" prefWidth="940" prefHeight="640" styleClass="tela-cadastro">
    <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="titulo" styleClass="titulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="situacao" styleClass="subtitulo"/>
    </HBox>

    <TabPane fx:id="abas" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Dados">
            <HBox spacing="20">
                <padding><Insets top="14" right="4" bottom="4" left="4"/></padding>

                <GridPane hgap="12" vgap="8" HBox.hgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints minWidth="125"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="220"/>
                    </columnConstraints>
                    <Label text="Código" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoCodigo" editable="false" focusTraversable="false" promptText="gerado ao salvar"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Nome *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoNome" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Categoria" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="campoCategoria" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Unidade *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="campoUnidade" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label text="Preço de venda *" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoPreco" promptText="0,00" styleClass="campo-numero"
                               GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    <Label text="Custo *" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoCusto" promptText="0,0000" styleClass="campo-numero"
                               GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    <Label text="Estoque mínimo" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoEstoqueMinimo" promptText="0" styleClass="campo-numero"
                               GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                    <Label text="Conteúdo líquido" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="7" GridPane.columnIndex="1">
                        <TextField fx:id="campoConteudo" promptText="ex.: 500" prefWidth="90" styleClass="campo-numero"/>
                        <ComboBox fx:id="campoUnidadeConteudo" prefWidth="80"/>
                        <Label fx:id="precoPorMedida" styleClass="subtitulo"/>
                    </HBox>
                    <Label text="Validade" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="campoControlaValidade" text="Controla validade e lotes"
                              GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                    <Label fx:id="rotuloEstoqueInicial" text="Estoque inicial" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                    <TextField fx:id="campoEstoqueInicial" promptText="0" styleClass="campo-numero"
                               GridPane.rowIndex="9" GridPane.columnIndex="1"/>
                    <Label fx:id="rotuloLoteInicial" text="Lote inicial" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                    <HBox fx:id="painelLoteInicial" spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="10" GridPane.columnIndex="1">
                        <TextField fx:id="campoLoteInicial" promptText="código (opcional)" prefWidth="120"/>
                        <DatePicker fx:id="campoValidadeInicial" promptText="validade" prefWidth="130"/>
                    </HBox>
                    <Label fx:id="rotuloEstoqueAtual" text="Estoque atual" GridPane.rowIndex="11" GridPane.columnIndex="0"/>
                    <Label fx:id="estoqueAtual" GridPane.rowIndex="11" GridPane.columnIndex="1"/>
                    <Label text="PLU (balança)" GridPane.rowIndex="12" GridPane.columnIndex="0"/>
                    <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="12" GridPane.columnIndex="1">
                        <TextField fx:id="campoPlu" promptText="balança ativa e unidade fracionada" HBox.hgrow="ALWAYS"/>
                        <Label text="Validade" minWidth="-Infinity"/>
                        <TextField fx:id="campoValidadeBalanca" promptText="—" prefWidth="56" minWidth="56"
                                   styleClass="campo-numero"/>
                        <Label text="dias" minWidth="-Infinity"/>
                    </HBox>
                    <Label text="Última alteração" GridPane.rowIndex="13" GridPane.columnIndex="0"/>
                    <Label fx:id="ultimaAlteracao" styleClass="subtitulo" GridPane.rowIndex="13" GridPane.columnIndex="1"/>
                </GridPane>

                <VBox spacing="10" prefWidth="380" minWidth="380">
                    <Label text="Códigos de barras" styleClass="titulo-secao"/>
                    <HBox spacing="8">
                        <TextField fx:id="campoNovoCodigo" promptText="Digite ou leia o código e tecle Enter"
                                   HBox.hgrow="ALWAYS" onAction="#adicionarCodigo"/>
                        <Button text="Adicionar" onAction="#adicionarCodigo"/>
                    </HBox>
                    <ListView fx:id="listaCodigos" prefHeight="110"/>
                    <HBox spacing="8">
                        <Button fx:id="botaoPrincipal" text="Marcar principal" onAction="#marcarPrincipal"/>
                        <Button fx:id="botaoRemoverCodigo" text="Remover" onAction="#removerCodigo"/>
                    </HBox>

                    <Label text="Simulador de preço" styleClass="titulo-secao"/>
                    <GridPane hgap="12" vgap="8" styleClass="simulador">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Lucro unitário" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lucroUnitario" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Margem (lucro ÷ preço)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="margem" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Markup (lucro ÷ custo)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="markup" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Margem desejada %" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoMargemDesejada" promptText="ex.: 30" styleClass="campo-numero"
                                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="Preço sugerido" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Label fx:id="precoSugerido" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    </GridPane>
                    <Button fx:id="botaoAplicarPreco" text="Aplicar preço sugerido" onAction="#aplicarPrecoSugerido"/>
                </VBox>
            </HBox>
        </Tab>
        <Tab fx:id="abaFornecedores" text="Fornecedores">
            <VBox spacing="8">
                <padding><Insets top="10" right="4" bottom="4" left="4"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Quem vende este produto: o principal dá o prazo e o fator da sugestão de compra."
                           styleClass="subtitulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="botaoIncluirVinculo" text="Incluir…" onAction="#incluirVinculo"/>
                    <Button fx:id="botaoAlterarVinculo" text="Alterar…" onAction="#alterarVinculo"/>
                    <Button fx:id="botaoPrincipalVinculo" text="Tornar principal" onAction="#tornarPrincipal"/>
                    <Button fx:id="botaoRemoverVinculo" text="Remover…" onAction="#removerVinculo"/>
                </HBox>
                <TableView fx:id="tabelaVinculos" VBox.vgrow="ALWAYS">
                    <placeholder><Label text="Nenhum fornecedor. Use &quot;Incluir…&quot; ou importe uma NF-e do fornecedor."/></placeholder>
                    <columns>
                        <TableColumn fx:id="colunaVinculoFornecedor" text="Fornecedor" prefWidth="230"/>
                        <TableColumn fx:id="colunaVinculoCodigo" text="Código no fornecedor" prefWidth="140"/>
                        <TableColumn fx:id="colunaVinculoFator" text="Fator" prefWidth="160"/>
                        <TableColumn fx:id="colunaVinculoPrazo" text="Prazo (dias)" prefWidth="85" styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaVinculoCusto" text="Último custo" prefWidth="100" styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaVinculoPrincipal" text="Principal" prefWidth="80"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>
        <Tab fx:id="abaHistorico" text="Histórico">
            <TableView fx:id="tabelaHistorico">
                <placeholder><Label text="Sem histórico: o produto ainda não foi salvo."/></placeholder>
                <columns>
                    <TableColumn fx:id="colunaData" text="Data/hora" prefWidth="140"/>
                    <TableColumn fx:id="colunaUsuario" text="Usuário" prefWidth="180"/>
                    <TableColumn fx:id="colunaPrecoHistorico" text="Preço (anterior → novo)" prefWidth="250"/>
                    <TableColumn fx:id="colunaCustoHistorico" text="Custo (anterior → novo)" prefWidth="250"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            </TableView>
        </Tab>
    </TabPane>

    <Label fx:id="mensagem" wrapText="true" minHeight="36" styleClass="mensagem"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="botaoExcluir" text="Excluir" onAction="#excluir"/>
        <Button fx:id="botaoSituacao" text="Inativar" onAction="#alternarSituacao"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Fechar" cancelButton="true" onAction="#fechar"/>
        <Button text="Salvar" defaultButton="true" onAction="#salvar" styleClass="botao-primario"/>
    </HBox>
</VBox>
