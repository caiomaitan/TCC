<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Relatório de fechamento de caixa (R11, 6.5): mostrado depois do fechamento às cegas. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.FechamentoCaixaController"
      spacing="10" styleClass="tela-cadastro" prefWidth="760">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <Label fx:id="titulo" styleClass="titulo"/>

    <HBox spacing="16">
        <GridPane hgap="12" vgap="6" styleClass="painel-formulario" HBox.hgrow="ALWAYS">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Terminal" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="terminal" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Abertura" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="abertura" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Fechamento" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="fechamento" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Nº de vendas" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="quantidadeVendas" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Total vendido" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="totalVendido" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Vendas canceladas" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <Label fx:id="canceladas" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <Label text="Descontos concedidos" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <Label fx:id="descontos" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        </GridPane>

        <GridPane hgap="12" vgap="6" styleClass="painel-formulario" HBox.hgrow="ALWAYS">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Fundo de troco" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="fundoTroco" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="(+) Vendas em dinheiro" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="vendasDinheiro" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="(+) Suprimentos" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="suprimentos" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="(−) Sangrias" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="sangrias" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="(−) Devoluções em dinheiro" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="devolucoes" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="(+) Recebimentos em dinheiro" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <Label fx:id="recebimentos" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <Label text="(=) Dinheiro esperado" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <Label fx:id="esperado" styleClass="titulo-secao" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            <Label text="Dinheiro contado" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
            <Label fx:id="contado" styleClass="titulo-secao" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
            <Label text="Diferença" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
            <Label fx:id="diferenca" styleClass="valor-destaque" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
        </GridPane>
    </HBox>

    <Label text="Vendas por forma de pagamento" styleClass="titulo-secao"/>
    <TableView fx:id="tabelaFormas" prefHeight="150">
        <placeholder><Label text="Nenhuma venda nesta sessão."/></placeholder>
        <columns>
            <TableColumn fx:id="colunaForma" text="Forma de pagamento" prefWidth="260"/>
            <TableColumn fx:id="colunaFormaVendas" text="Nº de vendas" prefWidth="120" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaFormaValor" text="Valor" prefWidth="140" styleClass="coluna-numero"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
    </TableView>

    <Label fx:id="recebimentosFormas" wrapText="true" styleClass="subtitulo" minHeight="-Infinity"/>

    <Label text="Sangrias e suprimentos" styleClass="titulo-secao"/>
    <TableView fx:id="tabelaMovimentos" prefHeight="150">
        <placeholder><Label text="Nenhuma sangria ou suprimento nesta sessão."/></placeholder>
        <columns>
            <TableColumn fx:id="colunaHora" text="Data/hora" prefWidth="130"/>
            <TableColumn fx:id="colunaTipo" text="Tipo" prefWidth="100"/>
            <TableColumn fx:id="colunaValor" text="Valor" prefWidth="110" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaMotivo" text="Motivo" prefWidth="220"/>
            <TableColumn fx:id="colunaUsuario" text="Usuário" prefWidth="130"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="botaoCsv" text="Exportar CSV…" onAction="#exportarCsv" minWidth="-Infinity"/>
        <Button fx:id="botaoPdf" text="Exportar PDF…" onAction="#exportarPdf" minWidth="-Infinity"/>
        <Label fx:id="mensagem" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Fechar" onAction="#fecharJanela" defaultButton="true" cancelButton="true"
                styleClass="botao-primario" minWidth="-Infinity"/>
    </HBox>
</VBox>
