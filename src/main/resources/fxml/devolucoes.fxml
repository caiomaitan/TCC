<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Devoluções (F13.4, menu próprio, permissão DEVOLUCAO): localizar a venda pelo número, pelo período ou pelo
     cliente; Devolver itens… (Enter) abre a devolução da venda; abaixo, as devoluções já feitas dela, com o
     comprovante. -->
<VBox fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.DevolucoesController"
      spacing="10" styleClass="tela-cadastro">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <Label text="Devoluções e trocas" styleClass="titulo"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Venda nº"/>
        <TextField fx:id="campoVenda" prefWidth="90" styleClass="campo-numero" onAction="#buscar"/>
        <Label text="ou de"/>
        <DatePicker fx:id="dataInicio" prefWidth="130"/>
        <Label text="até"/>
        <DatePicker fx:id="dataFim" prefWidth="130"/>
        <Label text="Cliente"/>
        <TextField fx:id="campoCliente" prefWidth="220" promptText="Nome ou CPF/CNPJ" onAction="#buscar"/>
        <Button text="Buscar" onAction="#buscar" defaultButton="true"/>
    </HBox>

    <TableView fx:id="tabelaVendas" VBox.vgrow="ALWAYS">
        <placeholder><Label text="Nenhuma venda finalizada encontrada."/></placeholder>
        <columns>
            <TableColumn fx:id="colunaVenda" text="Venda nº" prefWidth="90" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaData" text="Data/hora" prefWidth="140"/>
            <TableColumn fx:id="colunaOperador" text="Operador" prefWidth="170"/>
            <TableColumn fx:id="colunaCliente" text="Cliente" prefWidth="220"/>
            <TableColumn fx:id="colunaTotal" text="Total" prefWidth="110" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaDevolvido" text="Devolvido" prefWidth="110" styleClass="coluna-numero"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
    </TableView>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="botaoDevolver" text="Devolver itens… (Enter)" onAction="#devolver"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="resumo" styleClass="subtitulo"/>
    </HBox>

    <Label text="Devoluções da venda selecionada" styleClass="titulo-secao"/>
    <TableView fx:id="tabelaDevolucoes" prefHeight="150">
        <placeholder><Label text="Nenhuma devolução desta venda."/></placeholder>
        <columns>
            <TableColumn fx:id="colunaDevolucao" text="Devolução nº" prefWidth="100" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaDevolucaoData" text="Data/hora" prefWidth="140"/>
            <TableColumn fx:id="colunaUsuario" text="Registrada por" prefWidth="170"/>
            <TableColumn fx:id="colunaForma" text="Reembolso" prefWidth="210"/>
            <TableColumn fx:id="colunaItens" text="Itens" prefWidth="60" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaValor" text="Valor" prefWidth="110" styleClass="coluna-numero"/>
            <TableColumn fx:id="colunaMotivo" text="Motivo" prefWidth="200"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
    </TableView>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="botaoComprovante" text="Ver comprovante" onAction="#verComprovante"/>
    </HBox>
    <Label fx:id="mensagem" wrapText="true" minHeight="-Infinity"/>
</VBox>
