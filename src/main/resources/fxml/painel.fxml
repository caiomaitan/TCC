<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Painel (7.5, Fig. 15 revisada): cartões do dia com a variação em relação ao mesmo dia da semana anterior,
     gráfico de faturamento e lucro dos últimos 30 dias e top 5 do mês por lucro (só com RELATORIOS); alertas
     clicáveis e atalhos para todos. Carregado em Task. -->
<ScrollPane fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.varesync.controller.PainelController"
            fitToWidth="true" styleClass="painel-rolagem">
    <VBox spacing="12" styleClass="tela-cadastro">

        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="saudacao" styleClass="titulo"/>
                <Label fx:id="subtitulo" styleClass="subtitulo" wrapText="true"/>
            </VBox>
            <ProgressIndicator fx:id="progresso" visible="false" prefWidth="22" prefHeight="22"/>
            <Label fx:id="atualizado" styleClass="subtitulo" minWidth="-Infinity"/>
            <Button fx:id="botaoAtualizar" text="Atualizar (F5)" onAction="#atualizar" minWidth="-Infinity"/>
        </HBox>
        <Label fx:id="mensagem" wrapText="true"/>

        <VBox fx:id="secaoIndicadores" spacing="12">
            <HBox fx:id="cartoes" spacing="10"/>
            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="painel-formulario">
                    <Label text="Faturamento e lucro — últimos 30 dias" styleClass="titulo-secao"/>
                    <LineChart fx:id="grafico" prefHeight="280" minHeight="220" animated="false"
                               createSymbols="true" legendVisible="true">
                        <xAxis><CategoryAxis tickLabelRotation="-45"/></xAxis>
                        <yAxis><NumberAxis label="R$" forceZeroInRange="true"/></yAxis>
                    </LineChart>
                </VBox>
                <VBox spacing="4" prefWidth="380" minWidth="320" styleClass="painel-formulario">
                    <Label text="Top 5 do mês por lucro" styleClass="titulo-secao"/>
                    <TableView fx:id="tabelaTop" prefHeight="200" minHeight="170" VBox.vgrow="ALWAYS">
                        <placeholder><Label text="Nenhuma venda neste mês."/></placeholder>
                        <columns>
                            <TableColumn fx:id="colunaTopPosicao" text="#" prefWidth="30" styleClass="coluna-numero"
                                         sortable="false"/>
                            <TableColumn fx:id="colunaTopProduto" text="Produto" prefWidth="170" sortable="false"/>
                            <TableColumn fx:id="colunaTopLucro" text="Lucro" prefWidth="95" styleClass="coluna-numero"
                                         sortable="false"/>
                            <TableColumn fx:id="colunaTopMargem" text="Margem" prefWidth="70"
                                         styleClass="coluna-numero" sortable="false"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>

        <VBox spacing="4" styleClass="painel-formulario">
            <Label text="Alertas" styleClass="titulo-secao"/>
            <VBox fx:id="alertas" spacing="2"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Atalhos" styleClass="titulo-secao"/>
            <FlowPane fx:id="atalhos" hgap="8" vgap="8"/>
        </VBox>
        <Region minHeight="4"/>
    </VBox>
</ScrollPane>
