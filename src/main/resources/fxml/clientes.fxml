<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Clientes (F12.1, F12.2, F12.6): lista com busca + abas Cadastro, Compras e LGPD. Enter salva; Ctrl+N novo cliente. -->
<HBox fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.ClientesController"
      spacing="20" styleClass="tela-cadastro">

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Clientes" styleClass="titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Novo cliente (Ctrl+N)" onAction="#novo"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <TextField fx:id="campoBusca" promptText="Nome, CPF/CNPJ ou telefone (Enter)"
                       HBox.hgrow="ALWAYS" onAction="#pesquisar"/>
            <CheckBox fx:id="filtroInativos" text="Mostrar inativos" onAction="#pesquisar"/>
        </HBox>
        <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
            <placeholder><Label text="Nenhum cliente. Cadastre um em &quot;Novo cliente&quot;."/></placeholder>
            <columns>
                <TableColumn fx:id="colunaCodigo" text="Cód." prefWidth="48" styleClass="coluna-numero"/>
                <TableColumn fx:id="colunaNome" text="Nome" prefWidth="190"/>
                <TableColumn fx:id="colunaDocumento" text="CPF/CNPJ" prefWidth="128"/>
                <TableColumn fx:id="colunaTelefone" text="Telefone" prefWidth="118"/>
                <TableColumn fx:id="colunaSituacao" text="Situação" prefWidth="95"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        </TableView>
        <Label fx:id="resumo" styleClass="subtitulo"/>
    </VBox>

    <VBox spacing="8" prefWidth="470" minWidth="460" styleClass="painel-formulario">
        <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
        <Label fx:id="tituloFormulario" styleClass="titulo-secao"/>

        <TabPane fx:id="abas" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <Tab fx:id="abaCadastro" text="Cadastro">
                <ScrollPane fitToWidth="true" styleClass="rolagem-formulario">
                    <GridPane hgap="8" vgap="7">
                        <padding><Insets top="10" right="6" bottom="6" left="2"/></padding>
                        <columnConstraints>
                            <ColumnConstraints minWidth="92"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Nome *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoNome" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="CPF/CNPJ" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoDocumento" promptText="CPF ou CNPJ" GridPane.rowIndex="1"
                                   GridPane.columnIndex="1"/>
                        <Label text="Telefone" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <TextField fx:id="campoTelefone" promptText="(16) 99999-8888" HBox.hgrow="ALWAYS" minWidth="120"/>
                            <Label text="Nasc." minWidth="-Infinity"/>
                            <TextField fx:id="campoNascimento" promptText="dd/mm/aaaa" prefWidth="104" minWidth="104"/>
                        </HBox>
                        <Label text="E-mail" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoEmail" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="Endereço, nº" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <HBox spacing="8" GridPane.rowIndex="4" GridPane.columnIndex="1">
                            <TextField fx:id="campoLogradouro" HBox.hgrow="ALWAYS" promptText="Rua, avenida…"/>
                            <TextField fx:id="campoNumero" prefWidth="64" minWidth="56" promptText="Nº"/>
                        </HBox>
                        <Label text="Compl. / bairro" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <HBox spacing="8" GridPane.rowIndex="5" GridPane.columnIndex="1">
                            <TextField fx:id="campoComplemento" prefWidth="120" promptText="Complemento"/>
                            <TextField fx:id="campoBairro" HBox.hgrow="ALWAYS" promptText="Bairro"/>
                        </HBox>
                        <Label text="CEP / cidade" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <HBox spacing="8" GridPane.rowIndex="6" GridPane.columnIndex="1">
                            <TextField fx:id="campoCep" promptText="14000-000" prefWidth="98" minWidth="98"/>
                            <TextField fx:id="campoCidade" HBox.hgrow="ALWAYS" promptText="Cidade"/>
                            <ComboBox fx:id="campoUf" prefWidth="80" minWidth="80" promptText="UF"/>
                        </HBox>
                        <Label text="Observação" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <TextArea fx:id="campoObservacao" prefRowCount="2" wrapText="true"
                                  GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                        <CheckBox fx:id="campoConsentimento" wrapText="true"
                                  text="Aceita receber ofertas (consentimento de marketing)"
                                  GridPane.rowIndex="8" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
                        <Label fx:id="consentimentoInfo" styleClass="subtitulo" GridPane.rowIndex="9"
                               GridPane.columnIndex="0" GridPane.columnSpan="2"/>
                    </GridPane>
                </ScrollPane>
            </Tab>

            <Tab fx:id="abaCompras" text="Compras">
                <VBox spacing="8">
                    <padding><Insets top="10" right="2" bottom="4" left="2"/></padding>
                    <GridPane hgap="14" vgap="4">
                        <Label text="Total gasto" styleClass="subtitulo" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label text="Compras" styleClass="subtitulo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Ticket médio" styleClass="subtitulo" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label text="Última compra" styleClass="subtitulo" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                        <Label fx:id="totalGasto" styleClass="cartao-valor-pequeno" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="numeroCompras" styleClass="cartao-valor-pequeno" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label fx:id="ticketMedio" styleClass="cartao-valor-pequeno" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <Label fx:id="ultimaCompra" styleClass="cartao-valor-pequeno" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                    </GridPane>
                    <Label text="Histórico de compras" styleClass="titulo-secao"/>
                    <TableView fx:id="tabelaCompras" VBox.vgrow="ALWAYS" prefHeight="150">
                        <placeholder><Label text="Nenhuma compra identificada."/></placeholder>
                        <columns>
                            <TableColumn fx:id="colunaVenda" text="Venda nº" prefWidth="80" styleClass="coluna-numero"/>
                            <TableColumn fx:id="colunaData" text="Data/hora" prefWidth="140"/>
                            <TableColumn fx:id="colunaItens" text="Itens" prefWidth="60" styleClass="coluna-numero"/>
                            <TableColumn fx:id="colunaValor" text="Valor" prefWidth="100" styleClass="coluna-numero"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    </TableView>
                    <Label text="Produtos mais comprados" styleClass="titulo-secao"/>
                    <TableView fx:id="tabelaProdutos" VBox.vgrow="ALWAYS" prefHeight="150">
                        <placeholder><Label text="Nenhum produto."/></placeholder>
                        <columns>
                            <TableColumn fx:id="colunaProduto" text="Produto" prefWidth="190"/>
                            <TableColumn fx:id="colunaVezes" text="Compras" prefWidth="70" styleClass="coluna-numero"/>
                            <TableColumn fx:id="colunaQuantidade" text="Quantidade" prefWidth="90" styleClass="coluna-numero"/>
                            <TableColumn fx:id="colunaValorProduto" text="Valor" prefWidth="100" styleClass="coluna-numero"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <Tab fx:id="abaLgpd" text="LGPD">
                <VBox spacing="10">
                    <padding><Insets top="12" right="4" bottom="4" left="4"/></padding>
                    <Label text="Dados pessoais do cliente" styleClass="titulo-secao"/>
                    <Label fx:id="lgpdConsentimento" wrapText="true"/>
                    <Label wrapText="true" styleClass="subtitulo"
                           text="Exportar entrega ao cliente o cadastro, as compras e os produtos comprados, em PDF ou CSV. A exportação fica registrada na auditoria."/>
                    <HBox spacing="8">
                        <Button fx:id="botaoExportarPdf" text="Exportar PDF…" onAction="#exportarPdf"/>
                        <Button fx:id="botaoExportarCsv" text="Exportar CSV…" onAction="#exportarCsv"/>
                    </HBox>
                    <Separator/>
                    <Label wrapText="true" styleClass="subtitulo"
                           text="Anonimizar apaga o nome, o CPF/CNPJ, os contatos, o endereço, a data de nascimento e a observação, e inativa o cliente. As vendas continuam, como &quot;Cliente anonimizado nº X&quot;. Não pode ser desfeito. Só o supervisor pode anonimizar."/>
                    <HBox>
                        <Button fx:id="botaoAnonimizar" text="Anonimizar…" onAction="#anonimizar"/>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>

        <!-- minHeight USE_PREF_SIZE: o texto longo quebra a linha em vez de virar "…" (a aba é que encolhe) -->
        <Label fx:id="situacao" styleClass="subtitulo" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="mensagem" wrapText="true" minHeight="-Infinity" styleClass="mensagem"/>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="botaoExcluir" text="Excluir…" onAction="#excluir"/>
            <Button fx:id="botaoSituacao" text="Inativar" onAction="#alternarSituacao"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="botaoSalvar" text="Salvar" defaultButton="true" onAction="#salvar" styleClass="botao-primario"/>
        </HBox>
    </VBox>
</HBox>
