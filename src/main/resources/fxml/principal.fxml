<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Janela principal (8.1): menu lateral à esquerda, conteúdo à direita, barra de status embaixo. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="raiz" fx:controller="br.com.varesync.controller.PrincipalController"
            styleClass="janela-principal">

    <left>
        <VBox styleClass="menu-lateral" prefWidth="220" minHeight="0">
            <Label text="VareSync" styleClass="marca"/>
            <Label fx:id="nomeLoja" styleClass="loja" wrapText="true"/>
            <!-- Itens criados pelo controller, só os permitidos ao usuário. Rolam quando a janela é baixa, para a
                 barra de status continuar visível no tamanho mínimo (1280×720). -->
            <ScrollPane styleClass="menu-rolagem" fitToWidth="true" hbarPolicy="NEVER" minHeight="0"
                        focusTraversable="false" VBox.vgrow="ALWAYS">
                <VBox fx:id="menu" styleClass="menu-itens" spacing="2"/>
            </ScrollPane>
            <VBox styleClass="menu-rodape" spacing="2">
                <Button text="Minhas preferências" onAction="#minhasPreferencias" styleClass="item-menu"
                        maxWidth="Infinity"/>
                <Button text="Alterar senha" onAction="#alterarSenha" styleClass="item-menu" maxWidth="Infinity"/>
                <Button text="Log off" onAction="#logoff" styleClass="item-menu" maxWidth="Infinity"/>
                <Button text="Sair" onAction="#sair" styleClass="item-menu" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="conteudo" styleClass="conteudo"/>
    </center>

    <bottom>
        <HBox styleClass="barra-status" spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="4" right="12" bottom="4" left="12"/></padding>
            <Label fx:id="statusUsuario"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="statusTerminal"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="statusCaixa"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusConexao"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="statusDataHora"/>
        </HBox>
    </bottom>
</BorderPane>
