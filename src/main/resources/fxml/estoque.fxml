<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Consulta de estoque (Fig. 17 revisada): busca, saldo do produto, kardex por período e ajustes.
     F4 ajusta o estoque; F5 ajusta o saldo para um valor. -->
<VBox fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.EstoqueController"
      spacing="10" styleClass="tela-cadastro">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Estoque" styleClass="titulo"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="campoBusca" promptText="Nome, código ou código de barras" HBox.hgrow="ALWAYS"
                   onAction="#pesquisar"/>
        <CheckBox fx:id="filtroAbaixoMinimo" text="Só abaixo do mínimo" onAction="#pesquisar"/>
        <CheckBox fx:id="filtroInativos" text="Mostrar inativos" onAction="#pesquisar"/>
        <Button text="Buscar" onAction="#pesquisar"/>
    </HBox>

    <SplitPane orientation="VERTICAL" dividerPositions="0.38" VBox.vgrow="ALWAYS">
        <VBox spacing="6">
            <TableView fx:id="tabelaProdutos" VBox.vgrow="ALWAYS">
                <placeholder><Label text="Nenhum produto encontrado."/></placeholder>
                <columns>
                    <TableColumn fx:id="colunaCodigo" text="Código" prefWidth="80" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaNome" text="Produto" prefWidth="320"/>
                    <TableColumn fx:id="colunaCategoria" text="Categoria" prefWidth="150"/>
                    <TableColumn fx:id="colunaSaldo" text="Saldo" prefWidth="110" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaMinimo" text="Mínimo" prefWidth="100" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaValor" text="Valor em estoque" prefWidth="140"
                                 styleClass="coluna-numero"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            </TableView>
            <Label fx:id="resumo" styleClass="subtitulo"/>
        </VBox>

        <VBox spacing="10">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="tituloProduto" text="Selecione um produto" styleClass="titulo-secao"/>
                <Label fx:id="alerta" styleClass="mensagem-erro"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="botaoAjustar" text="Ajustar estoque… (F4)" onAction="#ajustar"
                        styleClass="botao-primario"/>
                <Button fx:id="botaoAjustarSaldo" text="Ajustar saldo para… (F5)" onAction="#ajustarSaldo"/>
            </HBox>

            <GridPane hgap="24" vgap="4" styleClass="painel-formulario">
                <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                <Label text="Saldo" styleClass="subtitulo" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="Estoque mínimo" styleClass="subtitulo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Custo médio" styleClass="subtitulo" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <Label text="Valor em estoque" styleClass="subtitulo" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <Label fx:id="saldoAtual" text="—" styleClass="valor-destaque" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="estoqueMinimo" text="—" styleClass="valor-destaque" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label fx:id="custoMedio" text="—" styleClass="valor-destaque" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Label fx:id="valorEstoque" text="—" styleClass="valor-destaque" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Movimentação de"/>
                <DatePicker fx:id="dataInicio" prefWidth="130"/>
                <Label text="até"/>
                <DatePicker fx:id="dataFim" prefWidth="130"/>
                <Button text="Filtrar" onAction="#atualizarKardex"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="mensagem" wrapText="true"/>
            </HBox>

            <TableView fx:id="tabelaKardex" VBox.vgrow="ALWAYS">
                <placeholder><Label fx:id="semMovimentos" text="Selecione um produto para ver a movimentação."/></placeholder>
                <columns>
                    <TableColumn fx:id="colunaDataHora" text="Data/hora" prefWidth="130"/>
                    <TableColumn fx:id="colunaTipo" text="Tipo" prefWidth="160"/>
                    <TableColumn fx:id="colunaQuantidade" text="Quantidade" prefWidth="100" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaSaldoApos" text="Saldo após" prefWidth="100" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaCusto" text="Custo" prefWidth="100" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaUsuario" text="Usuário" prefWidth="140"/>
                    <TableColumn fx:id="colunaOrigem" text="Origem / motivo" prefWidth="260"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            </TableView>
        </VBox>
    </SplitPane>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="F4 ajustar estoque · F5 ajustar saldo para… · Enter no campo de busca pesquisa" styleClass="subtitulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Saldo abaixo do mínimo em destaque; saldo negativo em vermelho." styleClass="subtitulo"/>
    </HBox>
</VBox>
