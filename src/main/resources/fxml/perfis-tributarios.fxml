<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Perfis tributários (F19.2), aba da janela Cadastro fiscal. Só o formato de cada campo é conferido ao salvar; as
     combinações erradas aparecem no relatório de inconsistências fiscais (R30). -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.PerfisTributariosController" spacing="12">
    <padding><Insets top="10" right="0" bottom="0" left="0"/></padding>

    <VBox spacing="8" HBox.hgrow="ALWAYS">
        <TableView fx:id="tabelaPerfis" VBox.vgrow="ALWAYS" prefWidth="560">
            <placeholder><Label text="Nenhum perfil tributário cadastrado. Use &quot;Novo perfil&quot;."/></placeholder>
            <columns>
                <TableColumn fx:id="colunaPerfilNome" text="Nome" prefWidth="170"/>
                <TableColumn fx:id="colunaPerfilCfop" text="CFOP" prefWidth="55"/>
                <TableColumn fx:id="colunaPerfilIcms" text="ICMS" prefWidth="140"/>
                <TableColumn fx:id="colunaPerfilPisCofins" text="PIS / COFINS" prefWidth="110"/>
                <TableColumn fx:id="colunaPerfilProdutos" text="Produtos" prefWidth="70" styleClass="coluna-numero"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        </TableView>
        <HBox spacing="10">
            <Button text="Novo perfil" onAction="#novo"/>
            <Button fx:id="botaoExcluirPerfil" text="Excluir…" onAction="#excluir"/>
        </HBox>
    </VBox>

    <VBox spacing="8" prefWidth="560" minWidth="520">
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="8" styleClass="painel-formulario">
            <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
            <Label fx:id="tituloPerfil" text="Novo perfil" styleClass="subtitulo"/>
            <GridPane fx:id="gradePerfil" hgap="10" vgap="7">
                <columnConstraints>
                    <ColumnConstraints minWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Nome *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="campoNomePerfil" promptText="Ex.: Tributado 18%" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="CFOP *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="campoCfop" promptText="5102" maxWidth="90" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Situação do ICMS *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="1">
                    <ComboBox fx:id="campoTipoIcms" prefWidth="210"/>
                    <TextField fx:id="campoSituacaoIcms" promptText="00" prefWidth="70"/>
                </HBox>
                <Label text="Alíquota do ICMS (%)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="campoAliquotaIcms" promptText="0,00" maxWidth="90" styleClass="campo-numero"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Redução da base (%)" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="campoReducao" promptText="CST 20 e 70" maxWidth="90" styleClass="campo-numero"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Label text="FCP (%)" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="campoFcp" promptText="CST 00 e 20" maxWidth="90" styleClass="campo-numero"
                           GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                <Label text="PIS: CST * e alíquota (%)" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <HBox spacing="8" GridPane.rowIndex="6" GridPane.columnIndex="1">
                    <TextField fx:id="campoCstPis" promptText="01" prefWidth="60"/>
                    <TextField fx:id="campoAliquotaPis" promptText="0,00" prefWidth="80" styleClass="campo-numero"/>
                </HBox>
                <Label text="COFINS: CST * e alíquota (%)" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <HBox spacing="8" GridPane.rowIndex="7" GridPane.columnIndex="1">
                    <TextField fx:id="campoCstCofins" promptText="01" prefWidth="60"/>
                    <TextField fx:id="campoAliquotaCofins" promptText="0,00" prefWidth="80" styleClass="campo-numero"/>
                </HBox>
                <Label text="Código de benefício" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <TextField fx:id="campoBeneficio" promptText="Ex.: SP010360 ou SEM CBENEF" maxWidth="220"
                           GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                <Label text="CST do IBS e da CBS" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                <TextField fx:id="campoCstIbsCbs" promptText="000" maxWidth="90" GridPane.rowIndex="9" GridPane.columnIndex="1"/>
                <Label text="cClassTrib" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                <TextField fx:id="campoCclassTrib" promptText="000001" maxWidth="110" GridPane.rowIndex="10" GridPane.columnIndex="1"/>
                <Label text="Redução da alíquota do IBS e da CBS (%)" wrapText="true" minHeight="-Infinity"
                       GridPane.rowIndex="11" GridPane.columnIndex="0"/>
                <TextField fx:id="campoReducaoIbsCbs" promptText="Sem redução" maxWidth="110" styleClass="campo-numero"
                           GridPane.rowIndex="11" GridPane.columnIndex="1"/>
                <CheckBox fx:id="campoPerfilAtivo" text="Ativo (oferecido para os produtos)" selected="true"
                          GridPane.rowIndex="12" GridPane.columnIndex="1"/>
            </GridPane>
            <Label wrapText="true" minHeight="-Infinity" styleClass="subtitulo" text="Só o formato de cada campo é conferido. Combinações erradas (CSOSN no regime normal, CFOP 5405 sem ST, alíquota numa situação isenta...) aparecem no relatório de inconsistências fiscais. O IBS e a CBS (reforma tributária) são opcionais: aqui só se cadastra e se confere o formato."/>
        </VBox>
    </ScrollPane>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="botaoSalvarPerfil" text="Salvar perfil" onAction="#salvar" styleClass="botao-primario"/>
        <Label fx:id="mensagemPerfil" wrapText="true" minHeight="-Infinity" maxWidth="430"/>
    </HBox>
    </VBox>
</HBox>
