<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Unidades de medida (F10.5): lista + sigla, descrição e fracionada. Enter salva; Esc fecha. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.varesync.controller.UnidadesController"
      spacing="10" prefWidth="620" prefHeight="520" styleClass="tela-cadastro">
    <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Unidades de medida" styleClass="titulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nova unidade" onAction="#nova"/>
    </HBox>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colunaSigla" text="Sigla" prefWidth="80"/>
            <TableColumn fx:id="colunaDescricao" text="Descrição" prefWidth="250"/>
            <TableColumn fx:id="colunaFracionada" text="Fracionada" prefWidth="100"/>
            <TableColumn fx:id="colunaProdutos" text="Produtos" prefWidth="90" styleClass="coluna-numero"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
    </TableView>

    <Label fx:id="tituloFormulario" styleClass="titulo-secao"/>
    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="campoSigla" promptText="Sigla *" prefWidth="100"/>
        <TextField fx:id="campoDescricao" promptText="Descrição *" HBox.hgrow="ALWAYS"/>
        <CheckBox fx:id="campoFracionada" text="Fracionada" minWidth="-Infinity"/>
    </HBox>
    <Label fx:id="situacaoUso" wrapText="true" minHeight="-Infinity" styleClass="subtitulo"/>

    <Label fx:id="mensagem" wrapText="true" minHeight="36" styleClass="mensagem"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="botaoExcluir" text="Excluir" onAction="#excluir"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Fechar" cancelButton="true" onAction="#fechar"/>
        <Button text="Salvar" defaultButton="true" onAction="#salvar" styleClass="botao-primario"/>
    </HBox>
</VBox>
