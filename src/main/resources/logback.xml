<?xml version="1.0" encoding="UTF-8"?>
<!-- Logs em ~/.varesync/logs/varesync.log, rotação diária, 30 dias (3.3).
     Nunca registrar senha, hash de senha ou senha do banco. -->
<configuration>
    <property name="PASTA_LOG" value="${user.home}/.varesync/logs"/>
    <property name="PADRAO" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="ARQUIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${PASTA_LOG}/varesync.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${PASTA_LOG}/varesync.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <logger name="br.com.varesync" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="ARQUIVO"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
